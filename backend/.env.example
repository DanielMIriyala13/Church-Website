# Bethesda Satyavakyam Church CMS - Backend Environment Configuration

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/church_cms?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:password@cluster0.mongodb.net/church_cms?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random secret in production)
JWT_SECRET=bethesda_church_cms_super_secret_jwt_key_2026_xyz

# Frontend URL for Production CORS (e.g. your Vercel deployment URL)
FRONTEND_URL=https://church-website.vercel.app

# Optional Cloudinary Storage for Photographs & Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
